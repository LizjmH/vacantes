generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-editor"
  output   = "./schema.erd"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id       String   @id @default(cuid())
  correo   String   @unique
  contra   String
  sesiones Sesion[]
}

model Sesion {
  id            String   @id @default(cuid())
  expiraEl      DateTime
  token         String
  creadoEl      DateTime
  actualizadoEl DateTime @updatedAt
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Empresa {
  id String @id @default(cuid())

  // Datos generales
  folio           String?       @unique
  rfc             String
  curp            String?
  tipoEmpleador   TipoEmpleador
  tipoPersona     TipoPersona?
  razonSocial     String?
  nombreComercial String?
  tipoSociedad    String?

  // Clasificación
  cantidadEempleados Int
  ramaActividad      String
  descripcion        String?

  // Información general
  correoGeneral     String
  paginaWeb         String?
  medioConocimiento MedioConocimiento?
  registroPortal    RegistroPortal

  // Relaciones
  contactoId  String           @unique
  contacto    ContactoEmpresa  @relation(fields: [contactoId], references: [id])
  domicilioId String           @unique
  domicilio   DomicilioEmpresa @relation(fields: [domicilioId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  vacantes Vacante[]

  creadoEl      DateTime @default(now())
  actualizadoEl DateTime @updatedAt

  @@index([razonSocial])
  @@index([rfc])
}

model DomicilioEmpresa {
  id String @id @default(cuid())

  calle          String?
  numeroExterior String?
  numeroInterior String?
  colonia        String?
  municipio      String?
  localidad      String?
  entidad        String?
  codigoPostal   String?
  entreCalles    String?

  empresa Empresa?
}

model ContactoEmpresa {
  id String @id @default(cuid())

  nombres      String
  apellidos    String
  cargo        String
  telefonoFijo String?
  extension    String?
  celular      String?
  correo       String?
  telsne       String?

  registrar Boolean @default(true)

  creadoEl      DateTime @default(now())
  actualizadoEl DateTime @updatedAt

  empresa Empresa?
}

model Vacante {
  id      String  @id @default(cuid())
  idSilap String? @unique

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  // Datos de la vacante
  puesto String
  plazas Int    @default(1)

  edadMinima  Int?
  edadMaxima  Int?
  escolaridad String?
  sexo        Sexo

  sueldoMensual Decimal @db.Decimal(10, 2)

  diasTrabajo    Int?
  horarioTrabajo String?

  experienciaAnios Int

  aceptaDiscapacidad Boolean           @default(false)
  tipoDiscapacidad   TipoDiscapacidad?

  descripcionPuesto String
  conocimientos     String
  prestaciones      String

  tiempoReclutamiento String

  // Control interno
  cubierta      Boolean  @default(false)
  fechaReinicio DateTime

  // Relaciones
  mediosContacto MedioContactoVacante[]
  seguimientos   SeguimientoVacante[]

  creadoEl      DateTime @default(now())
  actualizadoEl DateTime @updatedAt

  @@index([empresaId])
  @@index([fechaReinicio])
  @@index([cubierta])
  @@index([puesto])
}

model MedioContactoVacante {
  id String @id @default(cuid())

  vacanteId String
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  tipo    TipoMedioContacto
  horario String?

  @@index([vacanteId])
}

model SeguimientoVacante {
  id String @id @default(cuid())

  vacanteId String
  vacante   Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  fecha      DateTime             @default(now())
  resultado  ResultadoSeguimiento
  comentario String?
  curp       String?
  nombre     String?
  puesto     String?

  @@index([vacanteId])
  @@index([fecha])
}

enum TipoEmpleador {
  PRIVADA
  PUBLICA
  SOCIAL
}

enum TipoPersona {
  FISICA
  MORAL
}

enum TipoMedioContacto {
  CORREO
  DOMICILIO
  TELEFONO
  WHATSAPP
}

enum ResultadoSeguimiento {
  VIGENTE
  CUBIERTA
  PENDIENTE
}

enum Sexo {
  FEMENINO
  MASCULINO
  INDISTINTO
}

enum TipoDiscapacidad {
  AUDITIVA
  INTELECTUAL
  MENTAL
  MOTORA
  VISUAL
  COMUNICACION
  INTELECTUAL_MENTAL
  OTRAS
}

enum MedioConocimiento {
  REDES_SOCIALES
  CONOCIDOS
  PRENSA
  AMISTADES
  VISITA_DEL_SNE
}

enum RegistroPortal {
  SI
  NO
}
